{
	"name": "logi-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"cf:dev": "wrangler pages dev .svelte-kit/cloudflare",
		"cf:deploy": "bun run build && wrangler pages deploy .svelte-kit/cloudflare",
		"cf:tail": "wrangler pages deployment tail"
	},
	"devDependencies": {
		"@internationalized/date": "^3.8.2",
		"@lucide/svelte": "^0.515.0",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/adapter-cloudflare": "^7.0.5",
		"@sveltejs/kit": "^2.24.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.1.11",
		"@tanstack/table-core": "^8.21.3",
		"@types/leaflet": "^1.9.20",
		"bits-ui": "^2.8.11",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.36.5",
		"svelte-check": "^4.2.2",
		"svelte-sonner": "^1.0.5",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.11",
		"tw-animate-css": "^1.3.5",
		"typescript": "^5.8.3",
		"vite": "^7.0.4",
		"wrangler": "^4.24.4"
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"svelte-leaflet": "^0.2.0"
	}
}
