{
  "name": "ev-logiapp-monorepo",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:ios": "turbo dev:ios --filter=logi_api --filter=logi_app",
    "dev:android": "turbo dev:android --filter=logi_api --filter=logi_app",
    "dev:web": "turbo dev --filter=logi_api --filter=logi_web",
    "build": "turbo build",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.18"
}
